{:paths ["src"]
 ;; Zero third-party runtime deps for the wire/store/resolver layers (portable
 ;; .cljc). `nameserver.server` is the one JVM-only namespace (raw UDP/TCP
 ;; sockets have no portable equivalent on this stack's other runtimes — see
 ;; README "Why JVM for the socket layer").
 :deps {
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.json replaced clojure.data.json here (2026-09-24). An explicit
        ;; floor: kotoba.json/read-str and /write-str first exist at 9c11ad1, and
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/json {:git/sha "9c11ad189e64907700e8b4eb9b26f40336bffa01"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/zone {:git/sha "34d178d4ac6eef49d309e33f07e17f863c5408bd"}
        io.github.kotoba-lang/ipns {:git/sha "f2563eb1cb010c96f6dec1dfbd468fac93367498"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; TEST-ONLY. These two exist so `kotoba/nameserver/header_core.kotoba`
         ;; can be compiled and run inside the test JVM and checked against
         ;; `nameserver.wire`, which is the only thing keeping the two from
         ;; drifting apart in silence.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "6d08e3cffa09c003f8dbcdfaee964c4a1ea021ad"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "1e21a1f56613d7d4c7628af1945ebf1cf7862ff3"}
                      ;; The native executor, for the one test here that runs
                      ;; machine code rather than compiling it. Named directly
                      ;; because amu carries it in a :test alias and does not
                      ;; pass it on, and at this library's main because amu's
                      ;; pin predates 9114591.
                      io.github.kotoba-lang/kototama-native
                      {:git/url "https://github.com/kotoba-lang/kototama-native.git"
                       :git/sha "e52b41a68481033f40a511185e3347633612169a"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/zone {:local/root "../zone"}
                        io.github.kotoba-lang/ipns {:local/root "../tech-ipfs-specs-ipns"}}}
  ;; runnable example: boot a real UDP/TCP nameserver on the JVM
  :examples {:extra-paths ["examples"]}}}
